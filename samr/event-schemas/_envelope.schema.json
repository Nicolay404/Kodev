{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samr.local/schemas/_envelope.schema.json",
  "title": "SAMR domain event envelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "service_origin",
    "timestamp",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "service_origin": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "const": "1.0"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
